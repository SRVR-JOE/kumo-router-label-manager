# Normalize text files
* text=auto eol=lf

# Force Windows line endings for PowerShell scripts so Windows PowerShell 5.1
# parses here-strings correctly regardless of core.autocrlf setting.
*.ps1 text eol=crlf

# Explicit LF for scripts and source files that run on CI / Linux
*.sh   text eol=lf
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Treat these as binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.xlsx binary
*.xls  binary
*.pdf  binary
